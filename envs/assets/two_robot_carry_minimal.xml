<mujoco model="two_robot_carry_minimal">
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".8 .8 .8" rgb2=".9 .9 .9" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.1"/>
    <material name="red" rgba="0.8 0.1 0.1 1"/>
    <material name="blue" rgba="0.1 0.2 0.8 1"/>
    <material name="green" rgba="0.1 0.6 0.2 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 4"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="grid"/>

    <camera name="fixed" pos="0 -4 3" xyaxes="1 0 0 0 0.6 0.8"/>

    <body name="robot_a" pos="-0.6 0 0.1">
      <joint name="robot_a_x" type="slide" axis="1 0 0" damping="5"/>
      <joint name="robot_a_y" type="slide" axis="0 1 0" damping="5"/>
      <joint name="robot_a_yaw" type="hinge" axis="0 0 1" damping="1"/>
      <geom name="robot_a_geom" type="box" size="0.18 0.12 0.08" material="red" mass="5"/>
    </body>

    <body name="robot_b" pos="0.6 0 0.1">
      <joint name="robot_b_x" type="slide" axis="1 0 0" damping="5"/>
      <joint name="robot_b_y" type="slide" axis="0 1 0" damping="5"/>
      <joint name="robot_b_yaw" type="hinge" axis="0 0 1" damping="1"/>
      <geom name="robot_b_geom" type="box" size="0.18 0.12 0.08" material="blue" mass="5"/>
    </body>

    <body name="carry_object" pos="0 0.35 0.15">
      <freejoint name="object_free"/>
      <geom name="carry_object_geom" type="box" size="0.8 0.08 0.06" material="green" mass="1"/>
    </body>

    <geom name="wall_left" type="box" pos="-1.2 1.5 0.3" size="0.05 0.8 0.3" rgba="0.2 0.2 0.2 1"/>
    <geom name="wall_right" type="box" pos="1.2 1.5 0.3" size="0.05 0.8 0.3" rgba="0.2 0.2 0.2 1"/>
  </worldbody>

  <actuator>
    <motor name="robot_a_x_motor" joint="robot_a_x" gear="50" ctrlrange="-1 1"/>
    <motor name="robot_a_y_motor" joint="robot_a_y" gear="50" ctrlrange="-1 1"/>
    <motor name="robot_a_yaw_motor" joint="robot_a_yaw" gear="20" ctrlrange="-1 1"/>

    <motor name="robot_b_x_motor" joint="robot_b_x" gear="50" ctrlrange="-1 1"/>
    <motor name="robot_b_y_motor" joint="robot_b_y" gear="50" ctrlrange="-1 1"/>
    <motor name="robot_b_yaw_motor" joint="robot_b_yaw" gear="20" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
