{
  "schema_version": 3,
  "stage_id": "SSC-V7-M2-R3",
  "stage_family": "SSC-V7",
  "supersedes_stage_id": "SSC-V7-M2-R2",
  "status": "FROZEN_PENDING_DRY_RUN",
  "sidecar_only": true,
  "stage_source_of_truth": "executed expert privileged physical trajectories and exact environment success semantics",
  "stage_basis": "m2_r3_expert_stage_basis.json",
  "primary_key": ["task", "episode_sha256", "frame_index"],
  "required_fields": [
    "stage_id",
    "within_stage_progress",
    "per_agent_contribution",
    "remaining_goal_mask",
    "agent_object_role_slots",
    "grasp_contact_custody_state",
    "collision_drop_contention_risk",
    "causal_automaton_state",
    "label_validity_mask",
    "ambiguity_code"
  ],
  "label_semantics": {
    "sufficient_state": "current privileged physical state plus explicitly declared past-only causal automaton memory",
    "stage_id": "an actually observed expert macro-state, never a stage inferred only from intended planner code",
    "within_stage_progress": "bounded to [0,1] and derived from current geometry or achieved past events",
    "remaining_goal_mask": "only goals required by the executed expert trajectory and environment success semantics",
    "parallel_subgoals": "factorized predicates may coexist even when stage_id has one canonical name"
  },
  "forbidden_label_dependencies": [
    "frame_index",
    "wall_clock_time",
    "episode_length",
    "future_done",
    "future_success",
    "future_observation",
    "future_action"
  ],
  "tasks": {
    "lift_barrier": {
      "stages": ["approach", "single_support", "dual_support", "lifted"]
    },
    "camera_alignment": {
      "stages": ["approach", "partial_support_or_grasp", "camera_and_meat_controlled", "camera_and_meat_lifted"]
    },
    "long_pipeline_delivery": {
      "stages": ["approach", "custody_0", "handoff_01", "custody_1", "handoff_12", "custody_2", "handoff_23", "custody_3", "goal"]
    },
    "take_photo": {
      "stages": ["approach", "partial_support_or_grasp", "camera_and_meat_controlled", "photo_complete"],
      "factorized_predicates": ["camera_support_count_ge_2", "meat_grasped", "button_aligned", "photo_complete"],
      "note": "button_aligned is a terminal predicate, not an independently observed preterminal stage"
    },
    "pass_shoe": {
      "stages": ["approach", "agent0_custody", "handoff", "agent1_custody", "goal"]
    },
    "place_food": {
      "stages": ["approach", "meat_controlled", "meat_lifted", "aligned", "released"],
      "factorized_predicates": ["meat_grasped", "meat_lifted", "planar_alignment", "release_complete"],
      "note": "the pot remains a goal receptacle; executed expert trajectories do not physically contact, grasp, or lift it"
    }
  },
  "m2_acceptance_gate": {
    "required_field_presence_fraction": 1.0,
    "finite_and_domain_valid_fraction": 1.0,
    "terminal_progress_matches_environment_success": 1.0,
    "same_sufficient_state_consistency_fraction": 1.0,
    "agent_slot_equivariance_fraction": 1.0,
    "legal_automaton_transition_fraction": 1.0,
    "independent_episodes_per_required_category_min": 3,
    "ambiguous_frame_fraction_max": 0.01,
    "manual_audit_episodes_per_task": 5,
    "manual_transition_windows_per_task_min": 20,
    "manual_predicate_agreement_min": 0.95,
    "manual_terminal_role_custody_disagreements_max": 0
  }
}
