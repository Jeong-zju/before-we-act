# Copy this file to configs/automation.env and edit the copy.
# `configs/automation.env` is explicitly ignored by Git. Keep HF_TOKEN in the
# process environment, not in this file.

WORKSPACE_ROOT="${WORKSPACE_ROOT:-/home/replace-me/wam}"

FE_DIR_NAME="${FE_DIR_NAME:-fe_pc_wam}"
FE_REPO_URL="${FE_REPO_URL:-https://github.com/Jeong-zju/fe-pc-wam.git}"
FE_REF="${FE_REF:-main}"

ROBOFACTORY_DIR_NAME="${ROBOFACTORY_DIR_NAME:-RoboFactory}"
ROBOFACTORY_REPO_URL="${ROBOFACTORY_REPO_URL:-https://github.com/MARS-EAI/RoboFactory.git}"
ROBOFACTORY_REF="${ROBOFACTORY_REF:-main}"

# auto: use a root pyproject.toml + uv.lock when the selected RoboFactory fork
# provides them, otherwise fall back to upstream robofactory/requirements.txt.
ROBOFACTORY_ENV_MODE="${ROBOFACTORY_ENV_MODE:-auto}"
WAM_PYTHON="${WAM_PYTHON:-3.11}"
ROBOFACTORY_PYTHON="${ROBOFACTORY_PYTHON:-3.9}"

# The default formal profile is LiftBarrier M1 scratch.
HF_DATASET_REPO="${HF_DATASET_REPO:-your-hf-org/robofactory-liftbarrier-m1-v1}"
HF_DATASET_REVISION="${HF_DATASET_REVISION:-main}"
HF_DATASET_DIR="${HF_DATASET_DIR:-datasets/robofactory_lift_barrier_m1_v1}"
WAM_MANIFEST="${WAM_MANIFEST:-${HF_DATASET_DIR}/training_manifest.json}"
WAM_CONFIG="${WAM_CONFIG:-configs/wam_multimodal/m1_liftbarrier_scratch.yaml}"
WAM_CHECKPOINT="${WAM_CHECKPOINT:-checkpoints/m1_liftbarrier_scratch_seed101}"
WAM_SMOKE_CHECKPOINT="${WAM_SMOKE_CHECKPOINT:-checkpoints/preflight/m1_liftbarrier_automation_smoke}"

TRAIN_DEVICE="${TRAIN_DEVICE:-cuda:0}"
CLOSED_LOOP_DEVICE="${CLOSED_LOOP_DEVICE:-cuda:0}"
REQUIRE_CUDA="${REQUIRE_CUDA:-true}"
REQUIRE_VULKAN="${REQUIRE_VULKAN:-false}"
MIN_FREE_DISK_GB="${MIN_FREE_DISK_GB:-30}"

# Upload is an independent action. Large-folder mode is resumable and is the
# default for image-heavy robotics datasets.
HF_UPLOAD_REPO="${HF_UPLOAD_REPO:-${HF_DATASET_REPO}}"
HF_UPLOAD_DIR="${HF_UPLOAD_DIR:-${HF_DATASET_DIR}}"
HF_UPLOAD_REVISION="${HF_UPLOAD_REVISION:-main}"
HF_UPLOAD_MODE="${HF_UPLOAD_MODE:-large}"
HF_UPLOAD_PRIVATE="${HF_UPLOAD_PRIVATE:-true}"

# Set to false only for public, non-gated resources. The pinned DINOv3 model
# used by the default profile is gated and still requires an authorized token.
HF_REQUIRE_AUTH="${HF_REQUIRE_AUTH:-true}"
