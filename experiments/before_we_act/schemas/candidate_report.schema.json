{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "before-we-act/r10-candidate-report/v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "round", "candidate_id", "branch", "commit", "status",
    "training", "gate_zero", "gate20", "causal_intervention", "latency",
    "privileged_input_audit", "acceptance", "passed"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "round": {"const": "R10"},
    "candidate_id": {"enum": ["p0", "p1", "p2", "p3"]},
    "branch": {"type": "string"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["NOT_STARTED", "PREPARING", "DOWNLOADING", "TRAINING", "VALIDATING", "ACCEPTING", "PASSED", "FAILED", "STOPPED", "STALE", "UNKNOWN"]},
    "training": {"type": "object"},
    "gate_zero": {"type": "object"},
    "gate20": {"type": "object"},
    "causal_intervention": {"type": "object"},
    "latency": {"type": "object"},
    "privileged_input_audit": {"type": "object"},
    "acceptance": {"type": "array", "minItems": 5},
    "passed": {"type": "boolean"}
  }
}
