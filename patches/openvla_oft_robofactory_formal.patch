+class RoboFactoryDataset(Dataset):
+    """All-episode, local-only HDF5 adapter for decentralized OpenVLA-OFT."""
+
+    TASKS = (
+        "lift_barrier",
+        "camera_alignment",
+        "long_pipeline_delivery",
+        "take_photo",
+        "pass_shoe",
+        "place_food",
+    )
+
+    def __init__(
+        self,
+        root: Path,
+        action_tokenizer: ActionTokenizer,
+        base_tokenizer: PreTrainedTokenizerBase,
+        image_transform: ImageTransform,
+        prompt_builder_fn: Type[PromptBuilder],
+    ) -> None:
+        self.root = Path(os.environ.get("OPENVLA_ROBOFACTORY_ROOT", root))
+        self.action_tokenizer = action_tokenizer
+        self.base_tokenizer = base_tokenizer
+        self.image_transform = image_transform
+        self.prompt_builder_fn = prompt_builder_fn
+        self.items: list[tuple[str, int, int, int, str]] = []
+        action_rows, qpos_rows = [], []
+        expected_episodes = found_episodes = 0
+
+        for task in self.TASKS:
+            task_dir = self.root / task
+            manifest_path = task_dir / "training_manifest.json"
+            if not manifest_path.is_file():
+                raise FileNotFoundError(f"Missing pinned training manifest: {manifest_path}")
+            manifest = json.loads(manifest_path.read_text())
+            episodes = manifest.get("episodes", [])
+            if len(episodes) != 150:
+                raise RuntimeError(f"{task}: expected 150 episodes, found {len(episodes)}")
+            # Manifest split labels are deliberately ignored: every episode is training data.
+            for episode in episodes:
+                expected_episodes += 1
+                path = task_dir / episode["hdf5_path"]
+                if not path.is_file():
+                    raise FileNotFoundError(path)
+                with h5py.File(path, "r") as h:
+                    agent_keys = sorted(h["data/observation/agents"])
+                    if not agent_keys:
+                        raise RuntimeError(f"{path}: no local agent streams")
+                    n = int(h[f"data/observation/agents/{agent_keys[0]}/qpos"].shape[0])
+                    done = np.asarray(h["data/done"][:n], bool)
+                    first_done = np.flatnonzero(done)
+                    if len(first_done):
+                        n = int(first_done[0] + 1)
+                    agents = sorted(int(k.rsplit("_", 1)[1]) for k in agent_keys)
+                    text = h["data/task/text"][0]
+                    text = text.decode() if isinstance(text, bytes) else str(text)
+                    for agent in agents:
+                        image_key = f"data/observation/images/agent_{agent}"
+                        qpos_key = f"data/observation/agents/panda_{agent}/qpos"
+                        action_key = f"data/action/agents/panda_{agent}/commanded"
+                        if image_key not in h or qpos_key not in h or action_key not in h:
+                            raise RuntimeError(f"{path}: missing strict-local stream for agent {agent}")
+                        qpos = np.asarray(h[qpos_key][:n], np.float32)
+                        action = np.asarray(h[action_key][:n], np.float32)
+                        if qpos.shape != (n, PROPRIO_DIM) or action.shape != (n, ACTION_DIM) or len(h[image_key]) < n:
+                            raise RuntimeError(
+                                f"{path}: local stream shape mismatch for agent {agent}: "
+                                f"qpos={qpos.shape}, action={action.shape}, images={len(h[image_key])}, n={n}"
+                            )
+                        qpos_rows.append(qpos)
+                        action_rows.append(action)
+                        self.items.extend((str(path), agent, t, n, text) for t in range(n))
+                found_episodes += 1
+
+        if not self.items:
+            raise RuntimeError(f"No RoboFactory HDF5 files under {self.root}")
+        if os.environ.get("OPENVLA_ALLOW_INCOMPLETE_DATASET") != "1" and (
+            expected_episodes != 900 or found_episodes != 900
+        ):
+            raise RuntimeError(
+                f"Formal OpenVLA training requires 6x150 episodes; found {found_episodes}/{expected_episodes}"
+            )
+
+        actions = np.concatenate(action_rows, axis=0)
+        qpos = np.concatenate(qpos_rows, axis=0)
+        self.action_min, self.action_max = actions.min(0), actions.max(0)
+        self.qpos_min, self.qpos_max = qpos.min(0), qpos.max(0)
+        self.action_q01, self.action_q99 = np.quantile(actions, [0.01, 0.99], axis=0).astype(np.float32)
+        self.qpos_q01, self.qpos_q99 = np.quantile(qpos, [0.01, 0.99], axis=0).astype(np.float32)
+        self.action_mask = self.action_max - self.action_min > 1e-6
+        self.qpos_mask = self.qpos_max - self.qpos_min > 1e-6
+        if ACTION_PROPRIO_NORMALIZATION_TYPE == NormalizationType.BOUNDS:
+            self.action_low, self.action_high = self.action_min, self.action_max
+            self.qpos_low, self.qpos_high = self.qpos_min, self.qpos_max
+        elif ACTION_PROPRIO_NORMALIZATION_TYPE == NormalizationType.BOUNDS_Q99:
+            self.action_low, self.action_high = self.action_q01, self.action_q99
+            self.qpos_low, self.qpos_high = self.qpos_q01, self.qpos_q99
+        else:
+            raise ValueError(f"Unsupported RoboFactory normalization: {ACTION_PROPRIO_NORMALIZATION_TYPE}")
+        self.dataset_statistics = {
+            "robofactory": {
+                "action": {
+                    "min": self.action_min, "max": self.action_max,
+                    "q01": self.action_q01, "q99": self.action_q99, "mask": self.action_mask,
+                },
+                "proprio": {
+                    "min": self.qpos_min, "max": self.qpos_max,
+                    "q01": self.qpos_q01, "q99": self.qpos_q99, "mask": self.qpos_mask,
+                },
+                "num_trajectories": found_episodes,
+                "num_transitions": len(self.items),
+                "training_split_policy": "all_900_episodes_ignore_manifest_split",
+                "policy_contract": "shared_weights_local_rgb_qpos9_to_local_action8",
+            }
+        }
+
+    def __len__(self) -> int:
+        return len(self.items)
+
+    @staticmethod
+    def _normalize(value, low, high, mask):
+        scaled = 2.0 * (value - low) / (high - low + 1e-6) - 1.0
+        return np.where(mask, np.clip(scaled, -1.0, 1.0), np.clip(value, -1.0, 1.0)).astype(np.float32)
+
+    def __getitem__(self, index: int) -> Dict[str, Any]:
+        path, agent, t, n, instruction = self.items[index]
+        with h5py.File(path, "r") as h:
+            image = np.asarray(h[f"data/observation/images/agent_{agent}"][t], np.uint8)
+            qpos = np.asarray(h[f"data/observation/agents/panda_{agent}/qpos"][t], np.float32)
+            actions = np.asarray(
+                h[f"data/action/agents/panda_{agent}/commanded"][t:min(t + NUM_ACTIONS_CHUNK, n)],
+                np.float32,
+            )
+        if len(actions) < NUM_ACTIONS_CHUNK:
+            actions = np.concatenate(
+                [actions, np.repeat(actions[-1:], NUM_ACTIONS_CHUNK - len(actions), axis=0)], axis=0
+            )
+        actions = self._normalize(actions, self.action_low, self.action_high, self.action_mask)
+        proprio = self._normalize(qpos, self.qpos_low, self.qpos_high, self.qpos_mask)
+
+        action_chunk_string = "".join(self.action_tokenizer(actions))
+        prompt_builder = self.prompt_builder_fn("openvla")
+        for turn in (
+            {"from": "human", "value": f"What action should the robot take to {instruction.lower()}?"},
+            {"from": "gpt", "value": action_chunk_string},
+        ):
+            prompt_builder.add_turn(turn["from"], turn["value"])
+        input_ids = self.base_tokenizer(prompt_builder.get_prompt(), add_special_tokens=True).input_ids
+        labels = list(input_ids)
+        prefix_end = max(0, len(labels) - (len(action_chunk_string) + 1))
+        labels[:prefix_end] = [IGNORE_INDEX] * prefix_end
+        return {
+            "pixel_values": self.image_transform(Image.fromarray(image)),
+            "input_ids": torch.tensor(input_ids),
+            "labels": torch.tensor(labels),
+            "actions": actions,
+            "proprio": proprio,
+            "dataset_name": "robofactory",
+        }
+
+
+class RepeatedDistributedSampler(Sampler[int]):
+    """Deterministic disjoint rank shards repeated until a fixed step budget."""
+
+    def __init__(self, dataset: Dataset, samples_per_rank: int, rank: int, world_size: int, seed: int = 42):
+        self.dataset = dataset
+        self.samples_per_rank = int(samples_per_rank)
+        self.rank = int(rank)
+        self.world_size = int(world_size)
+        self.seed = int(seed)
+
+    def __len__(self) -> int:
+        return self.samples_per_rank
+
+    def __iter__(self):
+        produced = epoch = 0
+        n = len(self.dataset)
+        while produced < self.samples_per_rank:
+            generator = torch.Generator().manual_seed(self.seed + epoch)
+            indices = torch.randperm(n, generator=generator).tolist()
+            pad = (-len(indices)) % self.world_size
+            if pad:
+                indices.extend(indices[:pad])
+            shard = indices[self.rank :: self.world_size]
+            take = min(len(shard), self.samples_per_rank - produced)
+            yield from shard[:take]
+            produced += take
+            epoch += 1
+
