+                            if qpos.shape != (n, PROPRIO_DIM) or raw_action.shape != (n, ACTION_DIM):
+                                raise RuntimeError(
+                                    f"local shape drift {path}:{trajectory}:arm{arm}: "
+                                    f"qpos={qpos.shape}, action={raw_action.shape}"
+                                )
+                            action = np.clip(raw_action, self.ACTION_LOW, self.ACTION_HIGH)
+                            clipped_action_values += int(np.count_nonzero(action != raw_action))
+                            # Compute statistics over the actual future-chunk
+                            # labels (each chunk is referenced to qpos[t]).
+                            # Keep exact extrema and a bounded deterministic
+                            # subsample for quantiles to avoid an 8x memory
+                            # multiplier on every DDP rank.
+                            for block_start in range(0, n, 4096):
+                                block_end = min(n, block_start + 4096)
+                                t_idx = np.arange(block_start, block_end)[:, None]
+                                h_idx = np.arange(NUM_ACTIONS_CHUNK)[None, :]
+                                idx = np.minimum(t_idx + h_idx, n - 1)
+                                block_residual = action[idx, :7] - qpos[block_start:block_end, None, :7]
+                                residual_min = np.minimum(residual_min, block_residual.min(axis=(0, 1)))
+                                residual_max = np.maximum(residual_max, block_residual.max(axis=(0, 1)))
+                                residual_stat_rows.append(block_residual.reshape(-1, 7)[::16])
+                            qpos_rows.append(qpos)
+                            action_rows.append(action)
+                            start = len(self.items)
+                            self.items.extend(
+                                (str(path), trajectory, arm, t, n, self.PROMPTS[task], task) for t in range(n)
+                            )
+                            task_rows = list(range(start, start + n))
+                            self.task_indices[task].extend(task_rows)
+                            # Active rows are deliberately defined from the
+                            # clipped, executable absolute command.  This
+                            # avoids over-sampling planner values that the
+                            # simulator clips away.
+                            joint_motion = np.linalg.norm(action[:, :7] - qpos[:, :7], axis=1) > 0.01
+                            gripper_transition = (np.abs(action[:, 7]) < 0.95)
+                            if n > 1:
+                                gripper_transition[1:] |= np.abs(np.diff(action[:, 7])) > 0.05
+                            self.active_indices[task].extend(
+                                [idx for idx, active in zip(task_rows, joint_motion | gripper_transition) if active]
+                            )
+                            local_streams += 1
+                            task_transitions += n
+                        episodes += 1
+                        task_episodes += 1
+            if task_episodes != 150:
+                raise RuntimeError(f"{task}: expected 150 successful episodes, found {task_episodes}")
+            task_transition_counts[task] = task_transitions
+
+        if episodes != 600 or not self.items:
+            raise RuntimeError(f"formal MARS-Control training requires 600 episodes; found {episodes}")
+        actions, qpos = np.concatenate(action_rows), np.concatenate(qpos_rows)
+        # The policy predicts a residual for the seven joints, referenced to
+        # the qpos at the beginning of the chunk.  Gripper remains an absolute
+        # command in [-1, 1].  Statistics therefore must describe that encoded
+        # action, rather than the raw absolute joint targets.
+        residual_sample = np.concatenate(residual_stat_rows, axis=0)
+        self.action_min = np.concatenate([residual_min, np.asarray([actions[:, 7].min()], np.float32)])
+        self.action_max = np.concatenate([residual_max, np.asarray([actions[:, 7].max()], np.float32)])
+        self.qpos_min, self.qpos_max = qpos.min(0), qpos.max(0)
+        self.action_q01 = np.concatenate([np.quantile(residual_sample, 0.01, axis=0), np.asarray([np.quantile(actions[:, 7], 0.01)])]).astype(np.float32)
+        self.action_q99 = np.concatenate([np.quantile(residual_sample, 0.99, axis=0), np.asarray([np.quantile(actions[:, 7], 0.99)])]).astype(np.float32)
+        self.qpos_q01, self.qpos_q99 = np.quantile(qpos, [0.01, 0.99], axis=0).astype(np.float32)
+        self.action_mask = self.action_max - self.action_min > 1e-6
+        self.qpos_mask = self.qpos_max - self.qpos_min > 1e-6
+        self.action_low, self.action_high = self.action_min, self.action_max
+        self.qpos_low, self.qpos_high = self.qpos_min, self.qpos_max
+        self.dataset_statistics = {
+            "mars_control": {
+                "action": {"min": self.action_min, "max": self.action_max, "q01": self.action_q01,
+                           "q99": self.action_q99, "mask": self.action_mask},
+                "proprio": {"min": self.qpos_min, "max": self.qpos_max, "q01": self.qpos_q01,
+                            "q99": self.qpos_q99, "mask": self.qpos_mask},
+                "num_trajectories": episodes,
+                "num_local_streams": local_streams,
+                "num_transitions": len(self.items),
+                "task_transition_counts": task_transition_counts,
+                "training_split_policy": "all_600_successful_episodes_no_split",
+                "action_values_clipped_to_environment_bounds_before_statistics": clipped_action_values,
+                "action_encoding": "joint_residual_gripper_absolute",
+                "residual_reference": "qpos_at_chunk_start_t",
+                "active_motion_definition": "norm(clipped_absolute_joint_action-qpos)>0.01 or gripper_transition",
+                "sampling_policy": "equal_task_50pct_active_50pct_all_without_replacement_per_pool",
+                "formal_budget_covers_every_transition": True,
+                "policy_contract": "shared_weights_local_rgb_qpos9_to_local_action8",
+            }
+        }
+
+    def __len__(self) -> int:
+        return len(self.items)
+
+    def __getitem__(self, index: int) -> Dict[str, Any]:
+        path, trajectory, arm, t, n, instruction, _task = self.items[index]
+        with h5py.File(path, "r") as h:
+            group = h[trajectory]
+            image = np.asarray(group[f"obs/sensor_data/head_camera_agent{arm}/rgb"][t], np.uint8)
+            qpos = np.asarray(group[f"obs/agent/panda-{arm}/qpos"][t], np.float32)
+            actions = np.asarray(group[f"actions/panda-{arm}"][t:min(t + NUM_ACTIONS_CHUNK, n)], np.float32)
+        # Clip the absolute command first, matching ManiSkill's pd_joint_pos
+        # action-space semantics, then encode the whole future chunk relative
+        # to the current observation qpos[t].  Do not subtract each future
+        # qpos: that would change the OpenVLA-OFT chunk contract.
+        actions = np.clip(actions, self.ACTION_LOW, self.ACTION_HIGH)
+        if len(actions) < NUM_ACTIONS_CHUNK:
+            actions = np.concatenate([actions, np.repeat(actions[-1:], NUM_ACTIONS_CHUNK - len(actions), 0)], 0)
+        actions = np.concatenate([actions[:, :7] - qpos[:7][None, :], actions[:, 7:8]], axis=1)
+        actions = RoboFactoryDataset._normalize(actions, self.action_low, self.action_high, self.action_mask)
+        proprio = RoboFactoryDataset._normalize(qpos, self.qpos_low, self.qpos_high, self.qpos_mask)
+        action_chunk_string = "".join(self.action_tokenizer(actions))
+        prompt_builder = self.prompt_builder_fn("openvla")
+        for turn in (
+            {"from": "human", "value": f"What action should the robot take to {instruction}?"},
+            {"from": "gpt", "value": action_chunk_string},
+        ):
+            prompt_builder.add_turn(turn["from"], turn["value"])
+        input_ids = self.base_tokenizer(prompt_builder.get_prompt(), add_special_tokens=True).input_ids
+        labels = list(input_ids)
+        labels[:max(0, len(labels) - (len(action_chunk_string) + 1))] = [IGNORE_INDEX] * max(
+            0, len(labels) - (len(action_chunk_string) + 1)
+        )
+        return {"pixel_values": self.image_transform(Image.fromarray(image)),
+                "input_ids": torch.tensor(input_ids), "labels": torch.tensor(labels),
+                "actions": actions, "proprio": proprio, "dataset_name": "mars_control"}
