+class RepeatedDistributedSampler(Sampler[int]):
+    """Deterministic disjoint rank shards repeated until a fixed step budget."""
+
+    def __init__(self, dataset: Dataset, samples_per_rank: int, rank: int, world_size: int, seed: int = 42):
+        self.dataset = dataset
+        self.samples_per_rank = int(samples_per_rank)
+        self.rank = int(rank)
+        self.world_size = int(world_size)
+        self.seed = int(seed)
+
+    def __len__(self) -> int:
+        return self.samples_per_rank
+
+    def __iter__(self):
+        produced = epoch = 0
+        n = len(self.dataset)
+        while produced < self.samples_per_rank:
+            generator = torch.Generator().manual_seed(self.seed + epoch)
+            indices = torch.randperm(n, generator=generator).tolist()
+            pad = (-len(indices)) % self.world_size
+            if pad:
+                indices.extend(indices[:pad])
+            shard = indices[self.rank :: self.world_size]
+            take = min(len(shard), self.samples_per_rank - produced)
+            yield from shard[:take]
+            produced += take
+            epoch += 1
+
+
+class MarsControlTaskBalancedSampler(Sampler[int]):
+    """Task-balanced, active-motion-aware sampler for MARS-Control.
+
+    Each rank sees a fixed number of samples, while all ranks draw the same
+    deterministic global stream and take disjoint strided shards.  Tasks are
+    sampled equally; within a task, half of draws prefer active-motion rows and
+    half draw from the complete local transition set.
+    """
+
+    def __init__(self, dataset: MarsControlDataset, samples_per_rank: int,
+                 rank: int, world_size: int, seed: int = 42) -> None:
+        self.dataset = dataset
+        self.samples_per_rank = int(samples_per_rank)
+        self.rank = int(rank)
+        self.world_size = int(world_size)
+        self.seed = int(seed)
+
+    def __len__(self) -> int:
+        return self.samples_per_rank
+
+    def __iter__(self):
+        yielded = 0
+        epoch = 0
+        task_names = list(self.dataset.TASKS)
+        task_draw_counts = {task: 0 for task in task_names}
+        pool_orders: dict[tuple[str, bool], torch.Tensor] = {}
+        pool_cursors: dict[tuple[str, bool], int] = {}
+
+        def draw(task: str, use_active: bool, generator: torch.Generator) -> int:
+            key = (task, use_active)
+            pool = self.dataset.active_indices[task] if use_active else self.dataset.task_indices[task]
+            cursor = pool_cursors.get(key, 0)
+            order = pool_orders.get(key)
+            if order is None or cursor >= len(pool):
+                # Exhaust every transition in this pool before repeating any
+                # of it.  The all-row half of the 150k-step budget is large
+                # enough to cover even the 550,220-row four-arm task.
+                order = torch.randperm(len(pool), generator=generator)
+                pool_orders[key] = order
+                cursor = 0
+            value = pool[int(order[cursor].item())]
+            pool_cursors[key] = cursor + 1
+            return value
+
+        while yielded < self.samples_per_rank:
+            generator = torch.Generator().manual_seed(self.seed + epoch)
+            order = torch.randperm(len(task_names), generator=generator).tolist()
+            block_per_rank = min(4096, self.samples_per_rank - yielded)
+            global_count = block_per_rank * self.world_size
+            global_indices: list[int] = []
+            for offset in range(global_count):
+                task = task_names[order[offset % len(order)]]
+                active_rows = self.dataset.active_indices[task]
+                # Strict alternation gives exactly 50% active-pool and 50%
+                # all-row draws for each task, modulo at most one tail draw.
+                use_active = (task_draw_counts[task] % 2 == 0) and bool(active_rows)
+                task_draw_counts[task] += 1
+                global_indices.append(draw(task, use_active, generator))
+            shard = global_indices[self.rank::self.world_size]
+            yield from shard
+            yielded += len(shard)
+            epoch += 1
+
