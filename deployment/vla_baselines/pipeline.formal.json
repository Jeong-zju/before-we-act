{
  "schema": "bwa.vla.pipeline.v1",
  "stages": [
    {
      "name": "download_six_datasets",
      "argv": ["/venv/main/bin/python", "/workspace/repos/before-we-act/deployment/vla_baselines/download_datasets.py"],
      "cwd": "/workspace/repos/before-we-act",
      "env": {"HF_HOME": "/workspace/.hf_home", "HF_HUB_ENABLE_HF_TRANSFER": "0", "HF_XET_HIGH_PERFORMANCE": "1"},
      "gpus": [],
      "artifacts": [
        {"path": "/workspace/datasets/robofactory_multitask/lift_barrier/download_receipt.json", "kind": "json", "equals": {"status": "complete", "episodes_total": 150}},
        {"path": "/workspace/datasets/robofactory_multitask/camera_alignment/download_receipt.json", "kind": "json", "equals": {"status": "complete", "episodes_total": 150}},
        {"path": "/workspace/datasets/robofactory_multitask/long_pipeline_delivery/download_receipt.json", "kind": "json", "equals": {"status": "complete", "episodes_total": 150}},
        {"path": "/workspace/datasets/robofactory_multitask/take_photo/download_receipt.json", "kind": "json", "equals": {"status": "complete", "episodes_total": 150}},
        {"path": "/workspace/datasets/robofactory_multitask/pass_shoe/download_receipt.json", "kind": "json", "equals": {"status": "complete", "episodes_total": 150}},
        {"path": "/workspace/datasets/robofactory_multitask/place_food/download_receipt.json", "kind": "json", "equals": {"status": "complete", "episodes_total": 150}}
      ]
    },
    {
      "name": "audit_decentralized_training_contract",
      "argv": ["/workspace/venvs/robofactory/bin/python", "/workspace/repos/before-we-act/deployment/vla_baselines/audit_training_contract.py"],
      "cwd": "/workspace/repos/before-we-act",
      "gpus": [],
      "artifacts": [{"path": "/workspace/bwa_vla_runs/audit/training_contract.json", "kind": "json", "equals": {"status": "complete", "episodes": 900}}]
    },
    {
      "name": "train_rdt_1b_full",
      "argv": ["/workspace/repos/before-we-act/deployment/vla_baselines/run_rdt_1b.sh"],
      "cwd": "/workspace/repos/rdt-1b",
      "env": {"RDT_MAX_TRAIN_STEPS": "300000", "RDT_MICRO_BATCH": "1", "RDT_NUM_WORKERS": "1"},
      "gpus": [0, 1, 2, 3],
      "artifacts": [
        {"path": "/workspace/bwa_vla_runs/formal/rdt_1b/status.json", "kind": "json", "equals": {"status": "complete", "protocol": "decentralized_local_rgb_qpos_action"}},
        {"path": "/workspace/bwa_vla_runs/formal/rdt_1b/final", "kind": "dir"},
        {"path": "/workspace/bwa_vla_runs/formal/rdt_1b/final/pytorch_model.bin", "kind": "file"}
      ]
    },
    {
      "name": "validation20_rdt_1b",
      "argv": ["/workspace/repos/before-we-act/deployment/vla_baselines/run_validation20.sh", "rdt", "/workspace/bwa_vla_runs/formal/rdt_1b/final"],
      "cwd": "/workspace/repos/before-we-act",
      "gpus": [0, 1, 2, 3],
      "artifacts": [{"path": "/workspace/bwa_vla_runs/formal/rdt/validation20/summary.json", "kind": "json", "equals": {"status": "complete", "total_episodes": 120}}]
    },
    {
      "name": "train_openvla_oft_7b_lora",
      "argv": ["/workspace/repos/before-we-act/deployment/vla_baselines/run_openvla_oft.sh"],
      "cwd": "/workspace/repos/openvla-oft",
      "env": {"OPENVLA_MAX_STEPS": "150000", "OPENVLA_BATCH_SIZE": "8", "OPENVLA_SAVE_FREQ": "10000"},
      "gpus": [0, 1, 2, 3],
      "artifacts": [
        {"path": "/workspace/bwa_vla_runs/formal/openvla_oft/status.json", "kind": "json", "equals": {"status": "complete", "protocol": "decentralized_local_rgb_qpos_action"}},
        {"path": "/workspace/bwa_vla_runs/formal/openvla_oft/final", "kind": "dir"},
        {"path": "/workspace/bwa_vla_runs/formal/openvla_oft/final/action_head--latest_checkpoint.pt", "kind": "file"},
        {"path": "/workspace/bwa_vla_runs/formal/openvla_oft/final/lora_adapter/adapter_model.safetensors", "kind": "file"}
      ]
    },
    {
      "name": "validation20_openvla_oft",
      "argv": ["/workspace/repos/before-we-act/deployment/vla_baselines/run_validation20.sh", "openvla", "/workspace/bwa_vla_runs/formal/openvla_oft/final"],
      "cwd": "/workspace/repos/before-we-act",
      "gpus": [0, 1, 2, 3],
      "artifacts": [{"path": "/workspace/bwa_vla_runs/formal/openvla/validation20/summary.json", "kind": "json", "equals": {"status": "complete", "total_episodes": 120}}]
    },
    {
      "name": "train_pi05_lora",
      "argv": ["/workspace/repos/before-we-act/deployment/vla_baselines/run_pi05.sh"],
      "cwd": "/workspace/repos/openpi",
      "env": {"OPENPI_MAX_STEPS": "120000", "OPENPI_BATCH_SIZE": "32", "OPENPI_SAVE_INTERVAL": "1000"},
      "gpus": [0, 1, 2, 3],
      "artifacts": [
        {"path": "/workspace/bwa_vla_runs/formal/pi05/status.json", "kind": "json", "equals": {"status": "complete", "protocol": "decentralized_local_rgb_qpos_action"}},
        {"path": "/workspace/bwa_vla_runs/formal/pi05/final", "kind": "dir"},
        {"path": "/workspace/bwa_vla_runs/formal/pi05/final/params", "kind": "dir"}
      ]
    },
    {
      "name": "validation20_pi05",
      "argv": ["/workspace/repos/before-we-act/deployment/vla_baselines/run_validation20.sh", "pi05", "/workspace/bwa_vla_runs/formal/pi05/final"],
      "cwd": "/workspace/repos/before-we-act",
      "gpus": [0, 1, 2, 3],
      "artifacts": [{"path": "/workspace/bwa_vla_runs/formal/pi05/validation20/summary.json", "kind": "json", "equals": {"status": "complete", "total_episodes": 120}}]
    },
    {
      "name": "final_report_hashes",
      "argv": ["/venv/main/bin/python", "/workspace/repos/before-we-act/deployment/vla_baselines/final_report.py"],
      "cwd": "/workspace/repos/before-we-act",
      "gpus": [],
      "artifacts": [{"path": "/workspace/bwa_vla_runs/final_report.json", "kind": "json", "equals": {"status": "complete", "episodes": 900, "validation_episodes": 360}}]
    }
  ]
}
