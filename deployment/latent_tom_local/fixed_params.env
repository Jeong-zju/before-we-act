# Frozen parameters for the reported LatentToM strict-local baseline.
# Source this file from the launch scripts.  Existing environment values win
# so a deliberate new experiment must be explicit at invocation time.
export LATENT_TOM_SEED=${LATENT_TOM_SEED:-20260822}
export LATENT_TOM_STEPS=${LATENT_TOM_STEPS:-300000}
export LATENT_TOM_BATCH=${LATENT_TOM_BATCH:-512}
export LATENT_TOM_GRAD_ACCUM=${LATENT_TOM_GRAD_ACCUM:-1}
export LATENT_TOM_WORKERS=${LATENT_TOM_WORKERS:-16}
export LATENT_TOM_LOCALITY=${LATENT_TOM_LOCALITY:-16}
export LATENT_TOM_SAVE_EVERY=${LATENT_TOM_SAVE_EVERY:-5000}
export LATENT_TOM_WARMUP=${LATENT_TOM_WARMUP:-500}
export LATENT_TOM_LEARNING_RATE=${LATENT_TOM_LEARNING_RATE:-1e-4}
export LATENT_TOM_BETA1=${LATENT_TOM_BETA1:-0.95}
export LATENT_TOM_BETA2=${LATENT_TOM_BETA2:-0.999}
export LATENT_TOM_WEIGHT_DECAY=${LATENT_TOM_WEIGHT_DECAY:-1e-6}
export LATENT_TOM_OBS_STEPS=${LATENT_TOM_OBS_STEPS:-2}
export LATENT_TOM_ACTION_HORIZON=${LATENT_TOM_ACTION_HORIZON:-40}
export LATENT_TOM_ACTION_DIM=${LATENT_TOM_ACTION_DIM:-8}
export LATENT_TOM_CACHE_WORKERS=${LATENT_TOM_CACHE_WORKERS:-16}
export LATENT_TOM_VALIDATION_EPISODES=${LATENT_TOM_VALIDATION_EPISODES:-20}
export LATENT_TOM_VALIDATION_SEED=${LATENT_TOM_VALIDATION_SEED:-20260820}
export LATENT_TOM_DIFFUSION_STEPS=${LATENT_TOM_DIFFUSION_STEPS:-20}
export LATENT_TOM_REPLAN_INTERVAL=${LATENT_TOM_REPLAN_INTERVAL:-8}
